# Backend API and WebSocket origins.
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=http://localhost:8080

# Set to true to render the maintenance page instead of the application.
# While suspended, no API, SSE, WebSocket, or ping requests are made.
VITE_SERVICE_SUSPENDED=false

# The app resumes automatically after this ISO 8601 date.
# Defaults to 2026-12-01T00:00:00+05:30 when left empty.
VITE_SERVICE_RESUME_AT=
